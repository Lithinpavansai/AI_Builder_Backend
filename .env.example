# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
# Pinned active model ID (Note: Groq periodically deprecates and renames models; evaluation benchmarks are tied to this model)
GROQ_MODEL=openai/gpt-oss-120b
PORT=8000
ENVIRONMENT=development
# Configurable TPM limit (defaults to 8000 on Groq free tier)
GROQ_TPM_LIMIT=8000
# Configurable OTPM limit (default unset = no cap)
# GROQ_OTPM_LIMIT=1000
# Optional reasoning effort setting for openai/gpt-oss models (low, medium, high)
REASONING_EFFORT=low

